    {
      "name": "mathjax_build",
      "type": "directory",
      "children": [
        /*
         * SCRIPT: package_config.js
         * DESCRIPCIÓN: Configuración modular de extensiones TeX de MathJax optimizada para matemáticas y física
         * CONSTANTES: ACTIVE_PACKAGES
         */
        { "name": "package_config.js", "type": "file" },
        /*
         * SCRIPT: sanitizer.js
         * DESCRIPCIÓN: Sanitización y adaptación de XML SVG para compatibilidad con Qt TinySVG
         * FUNCIONES: stripSvgDimensions, ensureSvgXmlns, applySvgTheme, generateFallbackSvg, sanitizeSvgOutput
         */
        { "name": "sanitizer.js", "type": "file" },
        /*
         * SCRIPT: engine.js
         * DESCRIPCIÓN: Inicialización del motor MathJax y generador de nodos LiteDOM
         * FUNCIONES: convertLatexToSvgNode, nodeToOuterHtml, getAdaptor, getMathDocument
         */
        { "name": "engine.js", "type": "file" },
        /*
         * SCRIPT: renderer.js
         * DESCRIPCIÓN: Orquestador síncrono de renderizado LaTeX a SVG con soporte multi-firma
         * FUNCIONES: renderMathSync
         */
        { "name": "renderer.js", "type": "file" },
        /*
         * SCRIPT: index.js
         * DESCRIPCIÓN: Punto de entrada del bundle y binding global para MiniRacer / V8
         * FUNCIONES: renderMathSync
         */
        { "name": "index.js", "type": "file" },
        /*
         * SCRIPT: build.js
         * DESCRIPCIÓN: Script de compilación esbuild con banner de metadatos YAML hacia mathjax_bundle.js
         * FUNCIONES: buildBundle
         */
        { "name": "build.js", "type": "file" },
        { "name": "package.json", "type": "file" }
      ]
    },
    {
      "name": "src",
      "type": "directory",
      "children": [
        {
          "name": "assets",
          "type": "directory",
          "children": [
            { "name": "mathjax_bundle.js", "type": "file" }
          ]
        },
        {
          "name": "core",
          "type": "directory",
          "children": [
            /*
             * SCRIPT: __init__.py
             * DESCRIPCIÓN: Paquete del motor lógico (AST, Parser, Renderer, Syntax, Translator)
             */
            { "name": "__init__.py", "type": "file" },
            /*
             * SCRIPT: ast.py
             * DESCRIPCIÓN: Motor del Árbol de Sintaxis Abstracta (AST) y gestión de casillas (Slots)
             * CLASES: Slot, MathNode, TextNode, SymbolNode, OperatorNode, TemplateNode, FractionNode, PowerNode, SubscriptNode, SubSupNode, SquareRootNode, NthRootNode, DefiniteIntegralNode, IndefiniteIntegralNode, SummationNode, LimitNode, BracketNode, MatrixNode, DerivativeNode, StyleDecoratorNode, BinomialNode, MathTree
             */
            { "name": "ast.py", "type": "file" },
            /*
             * SCRIPT: logger.py
             * DESCRIPCIÓN: Sistema centralizado de registro de eventos y errores.
             * CLASES: SessionLogger
             * FUNCIONES: get_logger
             */
            { "name": "logger.py", "type": "file" },
            /*
             * SCRIPT: parser.py
             * DESCRIPCIÓN: Parser inverso de código LaTeX a sintaxis del árbol AST (LaTeXParser)
             * CLASES: _LaTeXStreamParser, LaTeXParser
             */
            { "name": "parser.py", "type": "file" },
            /*
             * SCRIPT: renderer.py
             * DESCRIPCIÓN: Renderizador visual de fórmulas LaTeX a QPixmap mediante Matplotlib OO Agg API
             * CLASES: MathRenderer
             */
            { "name": "renderer.py", "type": "file" },
            /*
             * SCRIPT: syntax.py
             * DESCRIPCIÓN: Motor de análisis de sintaxis y resaltado de colores para expresiones y LaTeX
             * CLASES: LaTeXSyntaxHighlighter
             * FUNCIONES: get_token_color, format_highlighted_html
             */
            { "name": "syntax.py", "type": "file" },
            /*
             * SCRIPT: translator.py
             * DESCRIPCIÓN: Capa de traducción de objetos MathTree a LaTeX, bloques Markdown y texto plano
             * CLASES: LaTeXTranslator
             */
            { "name": "translator.py", "type": "file" }
          ]
        },
        {
          "name": "data",
          "type": "directory",
